# Foundry / OpenAI
FOUNDRY_ENDPOINT=
PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
LLM_DEPLOYMENT=gpt-4.1-mini
IMAGE_DEPLOYMENT=gpt-image-2
AUDIO_DEPLOYMENT=gpt-4o-mini-tts
API_VERSION=2026-05-11-preview

# Cosmos DB
COSMOS_ENDPOINT=<endpoint>
COSMOS_KEY=<key>               # solo para desarrollo local
COSMOS_DATABASE=aventuras
COSMOS_CONTAINER=partidas
COSMOS_USUARIOS_CONTAINER=usuarios

# Blob Storage
STORAGE_ACCOUNT_NAME=<nombre>
STORAGE_CONTAINER=imagenes-aventuras
STORAGE_AVATARES_CONTAINER=avatares
STORAGE_CONNECTION_STRING=<connection_string>   # solo para desarrollo local

# Auth / JWT
JWT_SECRET=<secreto-largo-aleatorio>            # cambiar en producción
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080                         # 7 días

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=<connection_string>

# App config
LOG_LEVEL=INFO
# Tope de imágenes por partida. Las imágenes se generan a demanda (botón por
# turno), más la del primer y último turno. Los turnos son ilimitados.
MAX_IMAGENES_POR_PARTIDA=25
# Orígenes permitidos para CORS (lista separada por comas, sin barra final).
# En producción debe incluir el dominio por defecto de Static Web Apps
# (https://<algo>.azurestaticapps.net) y cualquier dominio personalizado,
# p. ej.: https://app.midominio.com,https://www.midominio.com
# Como allow_credentials=True, el comodín "*" no es válido: cada origen debe ser exacto.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Reintentos de transporte ante errores transitorios de Azure (red/5xx/429).
# No aplica a errores de schema (los reintenta PartidaService aparte).
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
